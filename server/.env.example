# DeepSeek API anahtarı — server üzerinde tutulur, browser'a sızmaz.
# Client istek'inde Authorization header yoksa bu key kullanılır.
DEEPSEEK_API_KEY=sk-...

# Backend portu (Vite proxy buraya yönlenir)
PORT=3001

# Jobs klasörü kök yolu (default: ./jobs)
# Kalıcı bir disk istiyorsan absolute path ver (örn. /Users/.../diress-jobs)
JOBS_DIR=
